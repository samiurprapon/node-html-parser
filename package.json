{
	"name": "node-html-parser",
	"version": "9.0.1",
	"description": "A very fast HTML parser, generating a simplified DOM, with basic element query support.",
	"packageManager": "pnpm@11.6.0",
	"main": "dist/index.cjs",
	"types": "dist/index.d.ts",
	"module": "dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"compile": "tsdown && tsc --emitDeclarationOnly --outDir dist",
		"build": "npm run lint && npm run compile",
		"watch": "tsdown --watch",
		"lint": "biome ci ./parser ./tests ./benchmark",
		"lint:fix": "biome check --write ./parser ./tests ./benchmark",
		"format": "biome format --write ./parser",
		"format:check": "biome format ./src",
		"typecheck": "tsc --noEmit",
		"---------------": "",
		"test": "pnpm run test:target",
		"test:src": "cross-env TEST_TARGET=src pnpm run test",
		"test:dist": "cross-env TEST_TARGET=dist pnpm run test",
		"benchmark": "node ./benchmark/compare.mjs",
		"---------------  ": "",
		"clean": "rimraf ./dist/",
		"clean:global": "pnpm run clean && rimraf pnpm-lock.yaml tests/node_modules node_modules",
		"reset": "pnpm run clean:global && pnpm install && pnpm build",
		"--------------- ": "",
		"test:target": "mocha \"./tests/*.js\" \"./tests/issues/*.js\"",
		"test:ci": "cross-env TEST_TARGET=dist pnpm run test:target",
		"posttest": "pnpm run benchmark",
		"prepare": "pnpm run build",
		"release": "standard-version && git push --follow-tags origin main"
	},
	"keywords": [
		"html",
		"parser",
		"nodejs",
		"typescript"
	],
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"author": "Xiaoyi Shi <ashi009@gmail.com>",
	"contributors": [
		"taoqf <tao_qiufeng@126.com>",
		"Ron S. <ron@nonara.com>"
	],
	"license": "MIT",
	"publishConfig": {
		"registry": "https://registry.npmjs.org"
	},
	"dependencies": {
		"css-select": "^5.1.0",
		"entities": "^8.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@types/node": "latest",
		"cheerio": "^1.2.0",
		"cross-env": "^7.0.3",
		"high5": "^1.0.0",
		"html-dom-parser": "^8.0.0",
		"html-parser": "^0.11.0",
		"html5parser": "^3.0.0",
		"htmljs-parser": "^5.10.2",
		"htmlparser": "^1.7.7",
		"htmlparser-benchmark": "^1.1.3",
		"htmlparser2": "^8.0.1",
		"mocha": "^11.7.6",
		"mocha-each": "^2.0.1",
		"parse5": "^8.0.1",
		"rimraf": "^3.0.2",
		"should": "latest",
		"standard-version": "^9.5.0",
		"ts-node": "^10.9.2",
		"tsdown": "^0.22.3",
		"typescript": "5.4.5"
	},
	"directories": {
		"test": "test"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/taoqf/node-fast-html-parser.git"
	},
	"bugs": {
		"url": "https://github.com/taoqf/node-fast-html-parser/issues"
	},
	"homepage": "https://github.com/taoqf/node-fast-html-parser",
	"sideEffects": false
}
